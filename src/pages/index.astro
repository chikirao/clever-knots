---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import {Image} from 'astro:assets';
import {site,works,asset,href} from '../lib/content';
import rope from '../assets/rope-logo.webp';
const featured=works.find(w=>w.featured)||works[0];
---
<Base home title="Связано руками">
  <div class="home-thread" data-thread>
    <section class="hero">
      <div class="hero-type"><h1 transition:name="studio-name">Clever<br /><span>Knots</span></h1><p class="hero-kicker">Мастерская ручной работы</p></div>
      <div class="hero-sculpture" data-rope-logo><Image src={rope} alt="Фирменный знак Clever Knots, сплетённый из коричневой хлопковой верёвки" loading="eager" fetchpriority="high" widths={[420,680,1024]} sizes="(min-width: 900px) 560px, 90vw" /><span data-rope-start aria-hidden="true"></span></div>
      <div class="hero-action"><p>{site.tagline}</p><a class="button" href={href('works/')}>Смотреть работы <Icon name="right" size={20} /></a><span>{site.heroNote}</span></div>
    </section>
    {featured && <section class="selected" id="selected"><div class="section-heading"><span class="section-note">Избранная работа</span><h2>{site.introTitle}</h2><p>{site.introText}</p></div><a class="selected-image" href={href(`works/${featured.slug}/`)}><Image src={asset(featured.images[0].src)} alt={featured.images[0].alt} widths={[390,780,1200]} sizes="(min-width:900px) 52vw, 100vw" transition:name={`work-${featured.slug}`} /><span class="image-action" aria-hidden="true"><Icon size={25} /></span></a><div class="work-caption"><div><span>{featured.category}</span><h3>{featured.title}</h3></div><a class="text-link" href={href(`works/${featured.slug}/`)}>Посмотреть работу <Icon size={18} /></a></div><span class="rope-anchor" data-rope-work aria-hidden="true"></span></section>}
    <section class="detail-section"><h2>Красота<br /><em>в деталях</em></h2><figure><Image src={asset('/src/assets/uploads/fiber-macro.webp')} alt="Тонкие хлопковые волокна и переплетение нитей крупным планом" widths={[390,780,1200]} sizes="(min-width:900px) 48vw, 100vw" /><figcaption>Нити. Узлы. Ручная работа.</figcaption></figure><span class="rope-anchor" data-rope-detail aria-hidden="true"></span></section>
    <section class="about-preview"><span class="section-note">О мастерской</span><h2>{site.aboutTitle}</h2><p>{site.aboutText}</p><a class="text-link" href={href('about/')}>Познакомиться с мастерской <Icon size={18} /></a></section>
    <Contact />
    <canvas class="thread-canvas" data-rope-canvas aria-hidden="true"></canvas>
  </div>
</Base>
