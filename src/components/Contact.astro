---
import {site} from '../lib/content';
import Icon from './Icon.astro';
---
<section class="contact" id="contact"><div class="contact-inner"><h2>{site.contactTitle}</h2><p>{site.contactText}</p><a class="button button-cream" href={site.vkUrl} target="_blank" rel="noopener noreferrer">Написать в VK <Icon size={20} /></a><span class="contact-address">vk.ru/klevermakrame</span></div><span data-rope-contact aria-hidden="true"></span></section>
